# ============================================================
#  SecureVoyage — Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env — it is blocked by .gitignore.
# ============================================================

# ── Web (apps/web/.env) ─────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs → Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ── API (apps/api/.env) ─────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Port the API server listens on
PORT=4000

# ── Optional future keys ─────────────────────────────────────
# JWT_SECRET=YOUR_RANDOM_SECRET_STRING
# DATABASE_URL=postgresql://user:pass@localhost:5432/securevoyage
# TWILIO_SID=YOUR_TWILIO_SID
# TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
